#!/bin/bash

set -eu

PYTHON="./.venv/bin/python3"
PIP="./.venv/bin/python3 -m pip"

main () {
    initialize_submodules
    create_virtualenv
    install_requirements
    build_libargon2
    install_project
}

initialize_submodules () {
    git submodule init
    git submodule update
}

create_virtualenv () {
    if [ "${NO_VIRTUALENV:-0}" -eq 1 ]; then
        PIP="pip"
        PYTHON="python"
        return
    fi
    python3 -m venv .venv
}

install_requirements () {
    $PIP install -r dev-requirements.txt
}

build_libargon2 () {
    $PYTHON setup.py build
}

install_project() {
    $PIP install -e .
}

main
